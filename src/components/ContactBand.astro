---
/*
 * Home contact band.
 *
 * Thin wrapper around `GradientBand` (the `form` variant) that owns the
 * Home page's contact copy and the `#contact` anchor the hero CTA and header
 * links point at. The form itself lives in the `GradientBand` slot.
 *
 * [PLACEHOLDER: contact section heading]
 * [PLACEHOLDER: texto de contacto, tiempo de respuesta y zona horaria]
 * [PLACEHOLDER: final contact address]
 */

import ContactForm from "./ContactForm";
import GradientBand from "./GradientBand.astro";

interface Props {
  locale?: "en" | "es";
}

const { locale = "en" } = Astro.props;

const content = {
  en: {
    heading: "Let's talk about your project",
    paragraph:
      "Tell me what you are building, what is in the way, and what a good outcome looks like. I reply within two business days.",
    preferEmail: "Prefer email?",
    email: "contact@endtoendsolutions.dev",
  },
  es: {
    heading: "Hablemos sobre tu proyecto",
    paragraph:
      "Cuéntame qué estás construyendo, qué te está frenando y qué resultado buscas. Te respondo en un plazo máximo de dos días hábiles.",
    preferEmail: "¿Prefieres el correo electrónico?",
    email: "contacto@endtoendsolutions.dev",
  },
};

const c = content[locale];
---

<GradientBand
  id="contact"
  variant="form"
  heading={c.heading}
  paragraph={c.paragraph}
  email={{ label: c.preferEmail, address: c.email }}
>
  <ContactForm client:visible />
</GradientBand>
