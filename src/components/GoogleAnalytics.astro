---
import { isValidMeasurementId } from "../lib/analytics";

interface Props {
  /** GA4 Measurement ID (`PUBLIC_GA_MEASUREMENT_ID` variable). */
  measurementId?: string;
  /** localStorage key where the consent decision is stored. */
  consentKey: string;
}

const { measurementId, consentKey } = Astro.props;
const gaId = isValidMeasurementId(measurementId)
  ? measurementId!.trim()
  : "";
---

{/* Reusable GA4 snippet.

    Google's library is not injected until explicit consent exists: the global
    `window.__e2eLoadGA` function is idempotent and only the consent banner
    (or a later visit with the decision already stored) calls it. If
    `PUBLIC_GA_MEASUREMENT_ID` is undefined or not in a valid format, the
    snippet stays inert. */}

<script is:inline define:vars={{ gaId, consentKey }}>
  (function () {
    var loaded = false;

    window.__e2eLoadGA = function () {
      if (loaded || !gaId) return;
      loaded = true;

      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = window.gtag || gtag;
      gtag("js", new Date());
      gtag("config", gaId, { send_page_view: true });

      var script = document.createElement("script");
      script.async = true;
      script.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaId);
      document.head.appendChild(script);
    };

    // Repeat visit: if consent was already granted, GA4 loads without asking.
    try {
      if (window.localStorage.getItem(consentKey) === "granted") {
        window.__e2eLoadGA();
      }
    } catch (error) {
      /* localStorage blocked (private mode): tracking stays off. */
    }
  })();
</script>