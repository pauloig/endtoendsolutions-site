---
import { isValidMeasurementId } from "../lib/analytics";

interface Props {
  /** Measurement ID de GA4 (variable `PUBLIC_GA_MEASUREMENT_ID`). */
  measurementId?: string;
  /** Clave de localStorage donde se guarda la decisión de consentimiento. */
  consentKey: string;
}

const { measurementId, consentKey } = Astro.props;
const gaId = isValidMeasurementId(measurementId)
  ? measurementId!.trim()
  : "";
---

{/* Snippet de GA4 reutilizable.

    No se inyecta la librería de Google hasta que existe consentimiento
    explícito: la función global `window.__e2eLoadGA` es idempotente y solo
    el banner de consentimiento (o una visita posterior con la decisión ya
    guardada) la invoca. Si `PUBLIC_GA_MEASUREMENT_ID` no está definida o no
    tiene un formato válido, el snippet queda inerte. */}

<script is:inline define:vars={{ gaId, consentKey }}>
  (function () {
    var loaded = false;

    window.__e2eLoadGA = function () {
      if (loaded || !gaId) return;
      loaded = true;

      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = window.gtag || gtag;
      gtag("js", new Date());
      gtag("config", gaId, { send_page_view: true });

      var script = document.createElement("script");
      script.async = true;
      script.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaId);
      document.head.appendChild(script);
    };

    // Visita posterior: si ya se había aceptado, GA4 carga sin pedirlo de nuevo.
    try {
      if (window.localStorage.getItem(consentKey) === "granted") {
        window.__e2eLoadGA();
      }
    } catch (error) {
      /* localStorage bloqueado (modo privado): se queda sin medir. */
    }
  })();
</script>