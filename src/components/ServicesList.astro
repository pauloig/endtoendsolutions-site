---
import Container from "./Container.astro";

interface Service {
  title: string;
  description: string;
  /** Secondary services are shown with less visual weight. */
  secondary?: boolean;
}

interface Props {
  locale?: "en" | "es";
}

const { locale = "en" } = Astro.props;

const content = {
  en: {
    heading: "How I can help",
    positioning:
      "Hands-on engineering and architecture for teams that need a senior perspective without committing to a permanent hire.",
    intro: "Engagements start where the risk is highest and end when it is paid off.",
    services: [
      {
        title: "Full-stack development",
        description:
          "Feature work and product iteration end to end, from data model to interface, in the stack your project already uses.",
      },
      {
        title: "Technical architecture & system design",
        description:
          "Decisions that hold up as the product grows: boundaries, data flows, integrations and a pragmatic migration path.",
      },
      {
        title: "Fractional / interim technical leadership",
        description:
          "Direction, reviews and mentoring for teams that need senior judgement without a full-time senior hire.",
      },
      {
        title: "Code & architecture review",
        description:
          "An outside read on an existing codebase or proposal: risks, shortcuts and the changes worth making now.",
      },
      {
        title: "Team augmentation",
        secondary: true,
        description:
          "Extra senior capacity for a sprint or a launch window, working inside your team's rituals and tooling.",
      },
    ],
  },
  es: {
    heading: "Cómo puedo ayudarte",
    positioning:
      "Ingeniería práctica y arquitectura para equipos que necesitan una visión senior sin comprometerse a una contratación fija.",
    intro: "Los proyectos empiezan donde el riesgo es mayor y terminan cuando ese riesgo está mitigado.",
    services: [
      {
        title: "Desarrollo full-stack",
        description:
          "Desarrollo e iteración de funcionalidades de principio a fin, desde el modelo de datos hasta la interfaz, usando el stack que ya utiliza tu proyecto.",
      },
      {
        title: "Arquitectura técnica y diseño de sistemas",
        description:
          "Decisiones sólidas que escalan con el producto: límites, flujos de datos, integraciones y un plan de migración pragmático.",
      },
      {
        title: "Liderazgo técnico parcial o interino",
        description:
          "Dirección, revisiones y mentoría para equipos que necesitan criterio senior sin contratar a tiempo completo.",
      },
      {
        title: "Revisión de código y arquitectura",
        description:
          "Una revisión externa de tu base de código o propuesta: riesgos, atajos y qué cambios vale la pena hacer ahora.",
      },
      {
        title: "Ampliación de equipo",
        secondary: true,
        description:
          "Capacidad senior adicional para un sprint o un lanzamiento, integrándome con los rituales y herramientas de tu equipo.",
      },
    ],
  },
};

const c = content[locale];
---

<section id="services" class="scroll-mt-16 border-b border-line">
  <Container class="py-14 sm:py-16">
    <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {c.heading}
    </h2>
    <p class="mt-3 max-w-2xl text-muted">
      {c.positioning}
    </p>
    <p class="mt-2 max-w-2xl text-muted">
      {c.intro}
    </p>

    <ul class="mt-10 grid gap-x-12 lg:grid-cols-2">
      {
        c.services.map((service) => (
          <li class="border-t border-line py-6 sm:py-7">
            <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] sm:gap-8 lg:grid-cols-1 lg:gap-2">
              <h3
                class:list={[
                  "text-base font-semibold",
                  service.secondary ? "text-muted" : "text-ink",
                ]}
              >
                {service.title}
              </h3>
              {service.description && (
                <p class="text-sm leading-relaxed text-muted sm:mt-0.5">
                  {service.description}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
