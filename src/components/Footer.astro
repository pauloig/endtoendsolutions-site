---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line bg-surface">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-start md:justify-between"
  >
    <div class="max-w-xs">
      <p class="text-xs font-semibold tracking-[0.18em] text-ink uppercase">
        End to End Solutions
      </p>
      <!-- [PLACEHOLDER: datos de contacto definitivos] -->
      <address class="mt-3 text-sm text-muted not-italic">
        <a
          href="mailto:hello@example.com"
          class="transition-colors hover:text-accent"
        >
          hello@example.com
        </a>
        <br />
        <span>Remote · worldwide</span>
      </address>
    </div>

    <nav aria-label="Footer">
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href="/privacy-policy"
            class="text-muted transition-colors hover:text-accent"
          >
            Privacy Policy
          </a>
        </li>
        <li>
          <!-- [PLACEHOLDER: enlace a LinkedIn/portfolio definitivo] -->
          <a
            href="https://example.com"
            class="text-muted transition-colors hover:text-accent"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-line">
    <p class="mx-auto max-w-5xl px-4 py-4 text-xs text-muted sm:px-6">
      © {year} End to End Solutions
    </p>
  </div>
</footer>