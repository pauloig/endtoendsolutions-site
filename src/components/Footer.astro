---
import Container from "./Container.astro";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line bg-paper">
  <Container
    class="flex flex-col gap-6 py-10 md:flex-row md:items-start md:justify-between"
  >
    <div class="max-w-xs">
      <p class="text-xs font-semibold tracking-[0.18em] text-ink uppercase">
        End to End Solutions
      </p>
      <!-- [PLACEHOLDER: datos de contacto definitivos] -->
      <address class="mt-3 text-sm text-muted not-italic">
        <a
          href="mailto:contact@endtoendsolutions.dev"
          class="transition-colors hover:text-accent"
        >
          contact@endtoendsolutions.dev
        </a>
        <br />
        <span>Remote · worldwide</span>
      </address>
    </div>

    <nav aria-label="Footer">
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href="/privacy-policy"
            class="text-muted transition-colors hover:text-accent"
          >
            Privacy Policy
          </a>
        </li>
        <li>
          <!-- [PLACEHOLDER: enlace a LinkedIn/portfolio definitivo] -->
          <a
            href="http://linkedin.com/in/pauloig"
            class="text-muted transition-colors hover:text-accent"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </nav>
  </Container>

  <div class="border-t border-line">
    <Container>
      <p class="py-4 text-xs text-muted">© {year} End to End Solutions</p>
    </Container>
  </div>
</footer>