---
/*
 * Shared site container.
 *
 * One max width and one set of horizontal paddings for the header, the footer
 * and every page section, so their left and right edges always line up.
 * Padding steps: 24px on mobile, 40px on tablet (md), 56px on desktop (lg).
 */

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["mx-auto w-full max-w-[1360px] px-6 md:px-10 lg:px-14", className]}>
  <slot />
</div>
