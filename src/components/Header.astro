---
interface Props {
  locale?: "en" | "es";
}

const { locale = "en" } = Astro.props;

const navItems = {
  en: [
    // [PLACEHOLDER: final links; About and Work do not have a page yet]
    { label: "Home", href: "/" },
    { label: "About", href: "/about" },
    { label: "Work", href: "/work", hidden: true },
  ],
  es: [
    // [PLACEHOLDER: enlaces definitivos; About y Work aún no tienen página]
    { label: "Inicio", href: "/es/" },
    { label: "Sobre mí", href: "/es/about" },
    { label: "Proyectos", href: "/es/work", hidden: true },
  ],
};

const items = navItems[locale];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const switchHref =
  locale === "en"
    ? currentPath === "/"
      ? "/es/"
      : currentPath.startsWith("/es/")
        ? currentPath
        : `/es${currentPath}`
    : currentPath.startsWith("/es/")
      ? currentPath.replace(/^\/es/, "") || "/"
      : currentPath;
const switchLabel = locale === "en" ? "ES" : "EN";
const switchAriaLabel = locale === "en" ? "Cambiar a español" : "Switch to English";
const themeLabels =
  locale === "en"
    ? { toDark: "Switch to dark theme", toLight: "Switch to light theme" }
    : { toDark: "Cambiar a tema oscuro", toLight: "Cambiar a tema claro" };
---

<header
  class="sticky top-0 z-30 border-b border-line bg-paper/85 backdrop-blur-sm"
>
  <div
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <a
      href={locale === "en" ? "/" : "/es/"}
      class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] uppercase transition-colors"
      aria-label="End to End Solutions"
    >
      <img src="/header-icon.png" alt="End to End Solutions" class="h-6 w-auto" width="24" height="24" />
      <span class="theme-toggle-wordmark hidden min-[360px]:inline">
        <span class="text-wordmark-primary">End to End</span>{" "}
        <span class="text-wordmark-secondary">Solutions</span>
      </span>
    </a>

    <nav aria-label="Main">
      <ul class="flex items-center gap-1 sm:gap-2">
        {
          items
            .filter((item) => !("hidden" in item && item.hidden))
            .map((item) => {
              const isCurrent = currentPath === item.href;

              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent ? "page" : undefined}
                    class:list={[
                      "rounded-md px-2 py-1.5 text-sm transition-colors sm:px-3",
                      isCurrent
                        ? "font-semibold text-ink"
                        : "text-muted hover:text-ink",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
        }
        <li>
          <a
            href={switchHref}
            aria-label={switchAriaLabel}
            class="ml-1 rounded-md border border-line px-2 py-1.5 text-xs font-medium text-ink transition-colors hover:bg-paper sm:px-2.5"
          >
            {switchLabel}
          </a>
        </li>
        <li>
          <button
            type="button"
            id="theme-toggle"
            aria-pressed="false"
            aria-label={themeLabels.toDark}
            data-label-to-dark={themeLabels.toDark}
            data-label-to-light={themeLabels.toLight}
            class="ml-1 inline-flex h-8 w-8 items-center justify-center rounded-md border border-line text-ink transition-colors hover:bg-paper"
          >
            <svg
              class="icon-moon"
              aria-hidden="true"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              class="icon-sun"
              aria-hidden="true"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function effectiveTheme(): "light" | "dark" {
    const attr = document.documentElement.getAttribute("data-theme");
    if (attr === "dark" || attr === "light") return attr;
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  function setupThemeToggle() {
    const button = document.getElementById("theme-toggle");
    if (!(button instanceof HTMLButtonElement)) return;

    const sync = () => {
      const isDark = effectiveTheme() === "dark";
      button.setAttribute("aria-pressed", String(isDark));
      const label = isDark
        ? button.dataset.labelToLight
        : button.dataset.labelToDark;
      if (label) button.setAttribute("aria-label", label);
    };

    button.addEventListener("click", () => {
      const next = effectiveTheme() === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("e2e_theme", next);
      } catch (e) {}
      sync();
    });

    sync();
  }

  setupThemeToggle();
</script>
