---
/*
 * Hero.
 *
 * Design constraint: the primary call to action has to be visible without
 * scrolling, even on the smallest viewport (320×568). That is why this block is
 * compact and scales in steps: paddings, heading size and button labels shrink
 * below 360px and 640px of width.
 *
 * Layout: split at 1024px and up (about 1.6fr / 1fr, 64px gap, vertically
 * centred). Below 1024px the columns stack, with the flow card after the CTA.
 * The headline is short and uses a fluid clamp() so it stays on two lines from
 * 1024px up (three at 320px). The positioning sentence that used to be the
 * headline is now the sub-line, so the primary CTA keeps a large margin above
 * the fold at 320×568.
 *
 * The h1 floor is 2rem, not the 2.25rem that would be ideal: at 320px the
 * content column is 272px wide and 2.25rem wraps this headline to four lines,
 * past the three-line target.
 */

import Container from "./Container.astro";

interface Props {
  locale?: "en" | "es";
}

const { locale = "en" } = Astro.props;

const content = {
  en: {
    tagline: "Senior technical partner",
    headline: "Senior judgment, hands-on delivery.",
    subheadline:
      "A senior technical partner who can embed as a developer, lead architecture decisions, or scale into a small team when the project needs it.",
    ctaPrimaryShort: "Let's talk",
    ctaPrimaryLong: "Start a conversation",
    ctaSecondary: "What I do",
    flowLabel: "From requirement to deployed",
    flowSteps: [
      "Requirements",
      "Architecture",
      "Build",
      "Deploy",
      "Support",
    ],
  },
  es: {
    tagline: "Socio técnico senior",
    headline: "Criterio senior, ejecución práctica.",
    subheadline:
      "Un socio técnico senior que puede integrarse como desarrollador, liderar decisiones de arquitectura o escalar a un pequeño equipo cuando el proyecto lo necesita.",
    ctaPrimaryShort: "Hablemos",
    ctaPrimaryLong: "Iniciar conversación",
    ctaSecondary: "Qué hago",
    flowLabel: "Del requerimiento al despliegue",
    flowSteps: [
      "Requerimientos",
      "Arquitectura",
      "Construcción",
      "Despliegue",
      "Soporte",
    ],
  },
};

const c = content[locale];
const flowLabelId = "home-flow-label";
---

<section class="border-b border-line bg-paper">
  <Container class="pt-8 pb-10 sm:pt-14 sm:pb-16">
    <div class="grid items-center gap-8 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
      <div>
        <p
          class="flex items-center gap-2 text-[0.7rem] font-semibold tracking-[0.18em] text-accent uppercase min-[360px]:text-xs"
        >
          <span aria-hidden="true" class="h-px w-6 bg-brand-gradient"></span>
          <!-- [PLACEHOLDER: etiqueta de posicionamiento definitiva] -->
          {c.tagline}
        </p>

        <h1
          class="mt-3 max-w-[18ch] text-[clamp(2rem,1.54rem+2.3vw,3.5rem)] leading-[1.1] font-semibold tracking-tight text-ink text-balance min-[360px]:mt-4"
        >
          <!-- [PLACEHOLDER: titular definitivo] -->
          {c.headline}
        </h1>

        <p
          class="mt-3 max-w-[60ch] text-[clamp(1.125rem,1.08rem+0.2vw,1.25rem)] leading-relaxed text-pretty text-muted sm:mt-4"
        >
          <!-- [PLACEHOLDER: two-line value proposition] -->
          {c.subheadline}
        </p>

        <div
          class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3 min-[360px]:gap-x-6 sm:mt-7"
        >
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 rounded-md bg-brand-violet px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-violet-ink sm:px-5 sm:py-3"
          >
            <span class="min-[360px]:hidden">{c.ctaPrimaryShort}</span>
            <span class="hidden min-[360px]:inline">{c.ctaPrimaryLong}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="#services"
            class="inline-flex items-center text-sm font-semibold text-accent underline underline-offset-4 transition-colors hover:text-accent-ink"
          >
            {c.ctaSecondary}
          </a>
        </div>
      </div>

      <div
        role="region"
        aria-labelledby={flowLabelId}
        class="w-full rounded-[20px] border border-line bg-surface p-7 lg:max-w-[480px]"
      >
        <p
          id={flowLabelId}
          class="text-[0.7rem] font-semibold tracking-[0.18em] text-muted uppercase"
        >
          {c.flowLabel}
        </p>
        <ol class="mt-5 space-y-4">
          {
            c.flowSteps.map((step, index) => (
              <li class="flex items-center gap-3">
                <span
                  aria-hidden="true"
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-violet text-xs font-semibold text-white"
                >
                  {index + 1}
                </span>
                <span class="text-sm font-medium text-ink">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Container>
</section>
