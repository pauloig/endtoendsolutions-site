---
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import GradientBand from "../components/GradientBand.astro";
import Header from "../components/Header.astro";
import Heading from "../components/Heading.astro";
import ListRow from "../components/ListRow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About Paulo Ismalej | End to End Solutions";
const description =
  "Senior full-stack engineer and architect with 20 years of experience. I take projects from requirements to a deployed, documented solution.";

const howIWork = [
  {
    title: "Decisions first.",
    body: "I spend my time on analysis, architecture and trade-offs, and I write them down, so you always know why something was built the way it was.",
  },
  {
    title: "Small, verifiable steps.",
    body: "Every piece of work has a clear acceptance criterion. Progress is something you can check, not something you have to trust.",
  },
  {
    title: "Honest about tools.",
    body: "I use modern tools, including AI assistants, to speed up routine implementation, and I stay accountable for every decision and every line that ships.",
  },
  {
    title: "Plain communication.",
    body: "You get clear options and a recommendation, not jargon.",
  },
];
---

<BaseLayout title={title} description={description}>
  <Header locale="en" />

  <main id="main" class="flex-1">
    <Container class="py-14 sm:py-16">
      <article class="max-w-[65ch]">
        <Heading as="h1" size="display">I'm Paulo Ismalej.</Heading>

        <p class="mt-4 leading-relaxed text-muted">
          I'm a senior full-stack engineer and software architect based in Guatemala City. For twenty years I've built and run software for banks, government agencies and growing businesses. Since 2022 I've done it as an independent technical partner, under End to End Solutions.
        </p>

        <section class="mt-10">
          <Heading as="h2" size="subheading">What I do</Heading>
          <p class="mt-3 leading-relaxed text-muted">
            I take a problem from the first conversation to a running, documented system: understanding the requirement, making the architecture decisions, building it, deploying it and supporting it afterwards. Depending on what the project needs, I join as a hands-on developer, as the architect or tech lead, or as the person who owns the whole build.
          </p>
        </section>

        <section class="mt-10">
          <Heading as="h2" size="subheading">Background</Heading>
          <p class="mt-3 leading-relaxed text-muted">
            I started in 2005 writing business applications and database code, then moved through enterprise .NET, Python and modern JavaScript stacks, plus AWS and containers. Along the way I led a development team on a national government platform deployed across hundreds of branches, led a core banking database migration planned for zero downtime, built the APIs behind a multi-merchant payments integration across Latin America, and took three enterprise systems from zero to production for international clients.
          </p>
        </section>

        <section class="mt-10">
          <Heading as="h2" size="subheading">How I work</Heading>
          <ul class="mt-4">
            {
              howIWork.map((item) => (
                <ListRow title={item.title}>{item.body}</ListRow>
              ))
            }
          </ul>
        </section>

        <section class="mt-10">
          <Heading as="h2" size="subheading">Beyond work</Heading>
          <p class="mt-3 leading-relaxed text-muted">
            Learning is something I enjoy for its own sake, not only because it serves my work. I explore new technologies and methodologies, and I'm most drawn to areas where I have no experience yet. Over the last few months I've been integrating AI into my workflows and applying spec-driven development.
          </p>
        </section>
      </article>
    </Container>

    <GradientBand
      variant="cta"
      heading="Have a project in mind?"
      paragraph="Tell me what you're building and what's in the way."
      cta={{ label: "Let's talk", href: "/#contact" }}
    />
  </main>

  <Footer />
</BaseLayout>
