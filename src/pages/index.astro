---
import ContactForm from "../components/ContactForm";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ServicesList from "../components/ServicesList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="[PLACEHOLDER: SEO title] Senior technical partner for web products"
  description="[PLACEHOLDER: meta description] A senior technical partner who embeds as a developer, leads architecture decisions, or scales into a small team when the project needs it."
>
  <Header />

  <main id="main">
    <Hero />

    <ServicesList />

    <section id="contact" class="scroll-mt-16 bg-surface">
      <div class="mx-auto grid max-w-5xl gap-10 px-4 py-14 sm:px-6 sm:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-16">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
            <!-- [PLACEHOLDER: contact section heading] -->
            Let's talk about your project
          </h2>
          <p class="mt-3 max-w-md text-muted">
            <!-- [PLACEHOLDER: texto de contacto, tiempo de respuesta y zona horaria] -->
            Tell me what you are building, what is in the way, and what a good
            outcome looks like. I reply within two business days.
          </p>

          <p class="mt-6 text-sm text-muted">
            Prefer email?
            <!-- [PLACEHOLDER: final contact address] -->
            <a
              href="mailto:hello@example.com"
              class="ml-1 font-medium text-accent underline underline-offset-2 hover:text-accent-ink"
            >
              hello@example.com
            </a>
          </p>
        </div>

        <ContactForm client:visible />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>