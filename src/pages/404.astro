---
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Heading from "../components/Heading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="[PLACEHOLDER: SEO title] Page not found"
  description="The page you were looking for does not exist. Head back to the home page of End to End Solutions."
  noindex
>
  <Header />

  <main id="main" class="flex flex-1 flex-col justify-center">
    <Container class="py-14 sm:py-16">
      <p class="font-mono text-sm text-accent">404</p>

      <Heading as="h1" size="display" class="mt-3 max-w-2xl leading-tight text-balance">
        <!-- [PLACEHOLDER: review the tone of the message; it already works] -->
        This page took an early exit.
      </Heading>

      <p class="mt-4 max-w-xl text-muted">
        The address you opened doesn't match anything on this site. It may have
        moved, or the link that brought you here was mistyped.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-brand-violet px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-violet-ink"
        >
          Back to home
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/#contact"
          class="inline-flex items-center justify-center rounded-md border border-line px-5 py-3 text-sm font-semibold text-ink transition-colors hover:bg-paper"
        >
          Contact me
        </a>
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>
