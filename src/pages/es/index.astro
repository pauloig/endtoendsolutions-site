---
import ContactForm from "../../components/ContactForm";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import ServicesList from "../../components/ServicesList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Socio Técnico Senior para Productos Web | End to End Solutions"
  description="Un socio técnico senior que se integra como desarrollador, lidera decisiones arquitectónicas o escala a un pequeño equipo cuando el proyecto lo necesita."
  lang="es"
>
  <Header locale="es" />

  <main id="main">
    <Hero locale="es" />

    <ServicesList locale="es" />

    <section id="contact" class="scroll-mt-16 bg-surface">
      <div class="mx-auto grid max-w-5xl gap-10 px-4 py-14 sm:px-6 sm:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-16">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
            Hablemos sobre tu proyecto
          </h2>
          <p class="mt-3 max-w-md text-muted">
            Cuéntame qué estás construyendo, qué te está frenando y qué resultado buscas. Te respondo en un plazo máximo de dos días hábiles.
          </p>

          <p class="mt-6 text-sm text-muted">
            ¿Prefieres el correo electrónico?
            <a
              href="mailto:pauloismalej@endtoendsolutions.dev"
              class="ml-1 font-medium text-accent underline underline-offset-2 hover:text-accent-ink"
            >
              pauloismalej@endtoendsolutions.dev
            </a>
          </p>
        </div>

        <ContactForm client:visible />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
