# ===== Public variables (exposed to the browser) =====
#
# Astro inlines PUBLIC_* variables into the bundle at build time
# (`pnpm build`), so changing them requires rebuilding the site.

# Google Analytics 4 Measurement ID (G-XXXXXXX format).
# Leaving it empty or undefined keeps the GA4 snippet inert: the site works
# the same, it just does not measure traffic, and the consent banner still
# appears.
# Get it at: https://analytics.google.com → Admin → Copy measurement ID
PUBLIC_GA_MEASUREMENT_ID=

# ===== Production (docker-compose.prod.yml) =====
#
# Do NOT reuse the development .env when deploying. Copy these keys into a
# .env.prod on the server, next to docker-compose.prod.yml.

# Public domain of the site. Also update `site` in astro.config.mjs.
SERVER_NAME=endtoendsolutions.dev

# Proxy entrypoints on the host.
HTTP_PORT=80
HTTPS_PORT=443

# 0 = HTTP only (useful for bringing the stack up locally).
# 1 = redirects to HTTPS and requires the `tls` profile (certbot issues the
# certificate via the http-01 ACME challenge).
TLS_ENABLED=0

# Email of the Let's Encrypt account holder (certificate issuance).
LETSENCRYPT_EMAIL=paulo.ismalej@gmail.com