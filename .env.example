# ===== Variables públicas (expuestas al navegador) =====
#
# Astro incrusta las variables PUBLIC_* en el bundle durante el build
# (`pnpm build`), por lo que cambiarlas exige reconstruir el sitio.

# Measurement ID de Google Analytics 4 (formato G-XXXXXXX).
# Vaciar o no definir la variable deja el snippet de GA4 inerte: el sitio
# funciona igual, simplemente no mide tráfico y el banner de consentimiento
# aparece igualmente.
# Obtenerlo en: https://analytics.google.com → Administración → Copiar ID de
# medición
PUBLIC_GA_MEASUREMENT_ID=

# ===== Producción (docker-compose.prod.yml) =====
#
# NO reutilices el .env de desarrollo al desplegar. Copia estas claves a un
# .env.prod en el servidor, junto con docker-compose.prod.yml.

# Dominio público del sitio. Sustituye también `site` en astro.config.mjs.
SERVER_NAME=endtoendsolutions.dev

# Puntos de entrada del proxy en el host.
HTTP_PORT=80
HTTPS_PORT=443

# 0 = solo HTTP (útil para levantar el stack localmente).
# 1 = redirige a HTTPS y requiere el perfil `tls` (certbot emite el
# certificado mediante el reto ACME http-01).
TLS_ENABLED=0

# Correo del titular de la cuenta de Let's Encrypt (emisión del certificado).
LETSENCRYPT_EMAIL=paulo.ismalej@gmail.com